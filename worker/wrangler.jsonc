{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tracker-fitness-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "2026102801",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}
